{
  "name": "sales-management-app",
  "version": "1.0.0",
  "description": "النظام الذكي لإدارة المبيعات والأقساط - تطبيق سطح مكتب",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "author": "Assil Al-Safi",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.salesmanagement.app",
    "productName": "برنامج تقسيط",
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["portable", "installer"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png"
    }
  }
}
